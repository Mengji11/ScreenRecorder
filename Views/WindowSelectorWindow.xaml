<Window x:Class="ScreenRecorder.Views.WindowSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制窗口" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E6F3FF"
        KeyDown="Window_KeyDown">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="请选择要录制的窗口：" FontSize="14" FontWeight="Bold" 
                   Foreground="#333" Margin="0,0,0,10"/>

        <!-- 窗口列表 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="lstWindows"
                     BorderThickness="0"
                     Background="White"
                     SelectionMode="Single"
                     MouseDoubleClick="LstWindows_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#333"/>
                            <TextBlock FontSize="11" Foreground="#999">
                                <Run Text="{Binding Width, Mode=OneWay}"/>
                                <Run Text=" x "/>
                                <Run Text="{Binding Height, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="刷新列表" Padding="15,8" Margin="0,0,10,0" Click="BtnRefresh_Click"
                    Background="White" Foreground="#4A90D9" BorderBrush="#4A90D9" BorderThickness="1"/>
            <Button Content="确认选择" Padding="15,8" Margin="0,0,10,0" Click="BtnConfirm_Click"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Padding="15,8" Click="BtnCancel_Click"
                    Background="White" Foreground="#666" BorderBrush="#D9D9D9" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
