<Window x:Class="ScreenRecorder.Views.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频编辑" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E6F3FF">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="视频编辑工具" FontSize="16" FontWeight="Bold" 
                   Foreground="#333" Margin="0,0,0,15"/>

        <!-- 功能选择 -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#D9D9D9">
            <!-- 视频裁剪 -->
            <TabItem Header="视频裁剪">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="选择要裁剪的视频文件：" Margin="0,0,0,10"/>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtTrimFile" Grid.Column="0" IsReadOnly="True" 
                                 Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        <Button Grid.Column="1" Content="浏览..." Margin="10,0,0,0" 
                                Padding="15,6" Click="BtnBrowseTrimFile_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="裁剪范围（格式：HH:mm:ss）：" Margin="0,0,0,10"/>
                    
                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开始时间：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtStartTime" Grid.Column="1" Text="00:00:00" 
                                 Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        <TextBlock Grid.Column="2" Text="结束时间：" VerticalAlignment="Center" Margin="15,0,8,0"/>
                        <TextBox x:Name="txtEndTime" Grid.Column="3" Text="00:00:00" 
                                 Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                    </Grid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="开始裁剪" Padding="20,8" Click="BtnTrim_Click"
                                Background="#4A90D9" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 视频合并 -->
            <TabItem Header="视频合并">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="选择要合并的视频文件（按顺序）：" Margin="0,0,0,10"/>
                    
                    <Border Grid.Row="1" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
                        <ListBox x:Name="lstMergeFiles" BorderThickness="0"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="添加文件" Padding="15,6" Margin="0,0,10,0" Click="BtnAddMergeFile_Click"
                                    Background="White" Foreground="#4A90D9" BorderBrush="#4A90D9" BorderThickness="1"/>
                            <Button Content="移除选中" Padding="15,6" Margin="0,0,10,0" Click="BtnRemoveMergeFile_Click"
                                    Background="White" Foreground="#FF4D4F" BorderBrush="#FF4D4F" BorderThickness="1"/>
                            <Button Content="上移" Padding="15,6" Margin="0,0,5,0" Click="BtnMoveUp_Click"
                                    Background="White" Foreground="#666" BorderBrush="#D9D9D9" BorderThickness="1"/>
                            <Button Content="下移" Padding="15,6" Click="BtnMoveDown_Click"
                                    Background="White" Foreground="#666" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Content="开始合并" Padding="20,8" Click="BtnMerge_Click"
                                    Background="#4A90D9" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="关闭" Padding="20,8" Click="BtnClose_Click"
                    Background="White" Foreground="#666" BorderBrush="#D9D9D9" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
