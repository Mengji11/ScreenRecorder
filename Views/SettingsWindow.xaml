<Window x:Class="ScreenRecorder.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="600"
        MinHeight="450" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#E6F3FF">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4">
            <StackPanel Margin="5">
                <RadioButton x:Name="navHotkeys" Content="快捷键设置" IsChecked="True" 
                             Checked="Nav_Checked" Margin="5" Padding="10,8" Cursor="Hand"/>
                <RadioButton x:Name="navRecording" Content="录制参数" 
                             Checked="Nav_Checked" Margin="5" Padding="10,8" Cursor="Hand"/>
                <RadioButton x:Name="navAudio" Content="音频设置" 
                             Checked="Nav_Checked" Margin="5" Padding="10,8" Cursor="Hand"/>
                <RadioButton x:Name="navWatermark" Content="水印设置" 
                             Checked="Nav_Checked" Margin="5" Padding="10,8" Cursor="Hand"/>
                <RadioButton x:Name="navSavePath" Content="保存路径" 
                             Checked="Nav_Checked" Margin="5" Padding="10,8" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 右侧内容 -->
        <Border Grid.Column="1" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" 
                CornerRadius="4" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="15">
                    <!-- 快捷键设置 -->
                    <StackPanel x:Name="pnlHotkeys" Visibility="Visible">
                        <TextBlock Text="快捷键设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="开始/停止录制:" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtHotkeyStartStop" Grid.Column="1" IsReadOnly="True" 
                                     Background="#F5F5F5" Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="暂停/继续录制:" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtHotkeyPauseResume" Grid.Column="1" IsReadOnly="True" 
                                     Background="#F5F5F5" Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图:" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtHotkeyScreenshot" Grid.Column="1" IsReadOnly="True" 
                                     Background="#F5F5F5" Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <CheckBox x:Name="chkCtrl" Content="Ctrl" IsChecked="True" Margin="0,0,10,0"/>
                            <CheckBox x:Name="chkAlt" Content="Alt" Margin="0,0,10,0"/>
                            <CheckBox x:Name="chkShift" Content="Shift" Margin="0,0,10,0"/>
                        </StackPanel>

                        <Button Content="恢复默认" HorizontalAlignment="Left" Margin="0,15,0,0" 
                                Padding="15,6" Click="BtnResetHotkeys_Click"/>
                    </StackPanel>

                    <!-- 录制参数 -->
                    <StackPanel x:Name="pnlRecording" Visibility="Collapsed">
                        <TextBlock Text="录制参数" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认分辨率:" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbDefaultResolution" Grid.Column="1">
                                <ComboBoxItem Content="1920x1080 (1080p)" IsSelected="True"/>
                                <ComboBoxItem Content="1280x720 (720p)"/>
                                <ComboBoxItem Content="2560x1440 (2K)"/>
                                <ComboBoxItem Content="3840x2160 (4K)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认帧率:" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbDefaultFrameRate" Grid.Column="1">
                                <ComboBoxItem Content="30fps" IsSelected="True"/>
                                <ComboBoxItem Content="60fps"/>
                                <ComboBoxItem Content="15fps"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="视频格式:" Grid.Column="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbOutputFormat" Grid.Column="1">
                                <ComboBoxItem Content="MP4 (H.264)" IsSelected="True"/>
                                <ComboBoxItem Content="AVI"/>
                                <ComboBoxItem Content="MKV"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="录制时长限制:" Grid.Column="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="txtMaxDuration" Width="60" Text="0" TextAlignment="Center" 
                                         Padding="5,4" BorderBrush="#D9D9D9" BorderThickness="1"/>
                                <TextBlock Text="分钟 (0=无限制)" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 音频设置 -->
                    <StackPanel x:Name="pnlAudio" Visibility="Collapsed">
                        <TextBlock Text="音频设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <CheckBox x:Name="chkRecordSystem" Content="录制系统声音" IsChecked="True" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chkRecordMic" Content="录制麦克风声音" IsChecked="True" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="系统声音设备:" Margin="0,15,0,8" Foreground="#666"/>
                        <ComboBox x:Name="cmbSystemDevice" HorizontalAlignment="Stretch"/>
                        
                        <TextBlock Text="麦克风设备:" Margin="0,15,0,8" Foreground="#666"/>
                        <ComboBox x:Name="cmbMicDevice" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- 水印设置 -->
                    <StackPanel x:Name="pnlWatermark" Visibility="Collapsed">
                        <TextBlock Text="水印设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <CheckBox x:Name="chkEnableWatermark" Content="启用水印" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="水印类型:" Margin="0,10,0,8" Foreground="#666"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbTextWatermark" Content="文字水印" IsChecked="True" Margin="0,0,15,0"/>
                            <RadioButton x:Name="rbImageWatermark" Content="图片水印"/>
                        </StackPanel>

                        <TextBlock Text="水印文字:" Margin="0,15,0,8" Foreground="#666"/>
                        <TextBox x:Name="txtWatermarkText" HorizontalAlignment="Stretch" 
                                 Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>

                        <TextBlock Text="水印位置:" Margin="0,15,0,8" Foreground="#666"/>
                        <ComboBox x:Name="cmbWatermarkPosition" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="右下角" IsSelected="True"/>
                            <ComboBoxItem Content="左下角"/>
                            <ComboBoxItem Content="右上角"/>
                            <ComboBoxItem Content="左上角"/>
                            <ComboBoxItem Content="居中"/>
                        </ComboBox>

                        <TextBlock Text="透明度:" Margin="0,15,0,8" Foreground="#666"/>
                        <Slider x:Name="sliderOpacity" HorizontalAlignment="Stretch" 
                                Minimum="0" Maximum="100" Value="50"/>
                    </StackPanel>

                    <!-- 保存路径 -->
                    <StackPanel x:Name="pnlSavePath" Visibility="Collapsed">
                        <TextBlock Text="保存路径" FontSize="14" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333"/>
                        
                        <TextBlock Text="默认保存位置:" Margin="0,0,0,8" Foreground="#666"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSavePath" Grid.Column="0" IsReadOnly="True" 
                                     Padding="8,6" BorderBrush="#D9D9D9" BorderThickness="1"/>
                            <Button Grid.Column="1" Content="浏览..." Margin="10,0,0,0" 
                                    Padding="15,6" Click="BtnBrowsePath_Click"/>
                        </Grid>

                        <TextBlock Text="文件命名规则:" Margin="0,20,0,8" Foreground="#666"/>
                        <TextBox x:Name="txtNamingPattern" HorizontalAlignment="Stretch" 
                                 Text="录屏_yyyyMMdd_HHmmss" IsReadOnly="True" Padding="8,6" 
                                 Background="#F5F5F5" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        <TextBlock Text="可用变量: yyyy=年, MM=月, dd=日, HH=时, mm=分, ss=秒" 
                                   FontSize="11" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 底部按钮 -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="取消" Padding="20,8" Margin="0,0,10,0" Click="BtnCancel_Click"
                                Background="White" Foreground="#666" BorderBrush="#D9D9D9" BorderThickness="1"/>
                        <Button Content="保存设置" Padding="20,8" Click="BtnSave_Click"
                                Background="#4A90D9" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
